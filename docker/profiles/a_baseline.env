# PROFILE_A_BASELINE — playbook.pdf §3, p.1: 4.0 CPUs · 4096 m · mem_swappiness 0
#
# MEMSWAP_LIMIT = MEM_LIMIT desactiva el swap del contenedor (SPEC A7).
# mem_swappiness por sí solo NO lo desactiva.
#
# Los valores EXPECT_* son lo que debe leerse DENTRO del contenedor.
# verify_limits.sh compara contra ellos y falla si no coinciden.

PROFILE_ID=PROFILE_A_BASELINE
CPUS_LIMIT=4.0
MEM_LIMIT=4096m
MEMSWAP_LIMIT=4096m
MEM_SWAPPINESS=0

EXPECT_CPU_MAX="400000 100000"
EXPECT_MEMORY_MAX=4294967296
EXPECT_SWAP_MAX=0
