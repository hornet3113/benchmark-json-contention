# PROFILE_C_SEVERE — playbook.pdf §3, p.1: 1.0 CPU · 1024 m · mem_swappiness 0
# Es el perfil donde el throttling de CFS debe ser visible (verificado en F0-V6).

PROFILE_ID=PROFILE_C_SEVERE
CPUS_LIMIT=1.0
MEM_LIMIT=1024m
MEMSWAP_LIMIT=1024m
MEM_SWAPPINESS=0

EXPECT_CPU_MAX="100000 100000"
EXPECT_MEMORY_MAX=1073741824
EXPECT_SWAP_MAX=0
