# Imágenes y credenciales locales — compartido por los tres perfiles.
#
# El manual dice "latest-stable" (playbook.pdf §2, p.1), que no es reproducible.
#
# Las imágenes se fijan POR DIGEST, no por etiqueta: una etiqueta como mongo:8.2
# es móvil y un docker pull futuro podría traer otra versión (8.2.13, …). El
# digest identifica exactamente la imagen verificada en F1 (2026-11-01,
# results/env/f1/docker_pull_20261101T164211Z.txt). La etiqueta de la que salió
# cada digest queda en el comentario de la misma línea.
#
# Para cambiar de versión: docker pull de la etiqueta nueva, copiar aquí su
# digest, y repetir las verificaciones de F1 (docs/F1_INFRAESTRUCTURA.md).

MONGO_IMAGE=mongo@sha256:e0ce8c35124d4a9f9785532d1f268f39e9728ffa1cb38f46fa482436424c4bd3  # mongo:8.2 -> MongoDB 8.2.12
PG_IMAGE=postgres@sha256:3a4264520e121176619f54ff867d12774bc81e95e7b84db58d63bccdb6144b81  # postgres:18 -> PostgreSQL 18.6

# Telemetría (F6-a, R-23). Mismo criterio: por digest. Descarga del 2026-11-02:
# results/f6/f6_1/docker_pull_20261102T031832Z.txt. cAdvisor ya no se publica en
# gcr.io (se quedó en v0.55.1); sale de ghcr.io/google/cadvisor.
PROMETHEUS_IMAGE=prom/prometheus@sha256:fa3302279710be2f21a8301ec17a8b4f2301fd829bd113839b3b6b02b6f191a2  # prom/prometheus:v3.15.1
CADVISOR_IMAGE=ghcr.io/google/cadvisor@sha256:b8e7d1093144fd088f425ff003d75a4aa405de075db78dae3bc563730b1bd07a  # ghcr.io/google/cadvisor:v0.60.6
NODE_EXPORTER_IMAGE=prom/node-exporter@sha256:1b4e4438faca4dd7e001dd445d161a4a2091b0fededa84093b3a8dfeae1f1be0  # prom/node-exporter:v1.12.1

# CPUs lógicas de la VM (F5-c). Topología medida en
# results/env/f5/cpu_topology_20261101T204105Z.txt: 0-7 = núcleos físicos 0-3,
# 8-11 = núcleos 4-5. El motor y el runner no comparten núcleo físico (SPEC §2,
# decisión 2; L5). Es un agregado al manual, que solo fija la cuota de CPU
# (`cpus`); la cuota sigue siendo la del perfil.
ENGINE_CPUSET=0-7
RUNNER_CPUSET=8-11
EXPECT_CPUSET=0-7

# Base de datos de MongoDB (F3). Mismo nombre que la de PostgreSQL.
MONGO_DB=bench

# Credenciales SOLO para este laboratorio. Los puertos se publican en 127.0.0.1,
# así que nada de esto es alcanzable desde fuera de la máquina.
POSTGRES_DB=bench
POSTGRES_USER=bench
POSTGRES_PASSWORD=bench_local_only
