\contentsline {section}{\numberline {6}Interpretación}{12}{section.6}%
\contentsline {subsection}{\numberline {6.1}M1: ¿cómo se degrada cada motor al apretar los recursos?}{12}{subsection.6.1}%
\contentsline {paragraph}{\texttt {Q1} (desanidar y agrupar): MongoDB gana siempre.}{12}{section*.9}%
\contentsline {paragraph}{\texttt {Q2} (ordenar y quedarse con el Top-1000): PostgreSQL gana, y la ventaja crece al apretar.}{12}{section*.10}%
\contentsline {paragraph}{La única excepción, y por qué no se usa.}{12}{section*.11}%
\contentsline {subsection}{\numberline {6.2}M2: ¿hubo volcado a disco y OOM, y dónde?}{12}{subsection.6.2}%
\contentsline {paragraph}{Volcado: sí, masivo, y solo en PostgreSQL con \texttt {Q1}.}{12}{section*.12}%
\contentsline {paragraph}{OOM: cinco filas, y hay que distinguir dónde ocurrió cada uno.}{13}{section*.13}%
\contentsline {paragraph}{La peor celda, y cómo no leerla.}{13}{section*.14}%
\contentsline {paragraph}{Respuesta a M2.}{13}{section*.15}%
